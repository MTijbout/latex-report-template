# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.ist
*.fdb_latexmk
*.synctex.gz

# Bibliography build artifacts (references.bib itself stays tracked)
*.bbl
*.bcf
*.blg
*.run.xml

# Glossaries/acronyms build artifacts
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls

# Editor/OS junk
.DS_Store
*.swp

# Compiled PDF output (source is tracked, not the build result)
# Only ignores PDFs in the project root (the compiled report),
# not source PDFs used as figures/includes.
/*.pdf
